# ==============================================================================
# LANG SON OJ - BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# ==============================================================================

# 1. DATABASE (Cơ sở dữ liệu PostgreSQL - Supabase / Neon)
# Chuỗi kết nối Supabase Connection Pooler (Hỗ trợ cả IPv4 & IPv6, khuyên dùng):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Hoặc chuỗi kết nối Direct Connection (IPv6):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. MÁY CHẤM PISTON API ENGINE
# Endpoint Piston API công khai (Không cần API Key, chạy trực tiếp):
PISTON_API_URL="https://emkc.org/api/v2/piston/execute"

# 3. BẢO MẬT BẢNG QUẢN TRỊ (ADMIN PANEL)
# Mã bí mật để đăng nhập vào trang /admin:
ADMIN_SECRET_KEY="admin123"

# 4. CẤU HÌNH NODE & PORT
# Render sẽ tự động gán biến PORT (ví dụ 10000). Ở môi trường local mặc định là 3000:
PORT=3000
NODE_ENV="production"

# 5. MÁY CHẤM PHỤ TRỢ (TÙY CHỌN - NẾU CẦN DỰ PHÒNG JUDGE0)
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY="your-rapidapi-key-here"
